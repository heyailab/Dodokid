# DodoKid CloudBase backend environment variables (template).
# Copy to .env or set these in the CloudBase console. Never commit real secrets.

# CloudBase environment id
TCB_ENV=dodokid-env

# JWT signing secret. REQUIRED in production. Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# Token lifetimes (seconds)
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
GATE_TOKEN_TTL_SEC=300

# SMS verification code
SMS_CODE_TTL_SEC=300
SMS_CODE_LENGTH=6

# Rate limiting (requests per caller per minute)
SMS_RATE_LIMIT_PER_MIN=10
LOGIN_RATE_LIMIT_PER_MIN=10
DEFAULT_RATE_LIMIT_PER_MIN=60

# SMS provider: "log" (development, prints code) or "tencent" (wire SDK)
SMS_PROVIDER=log

# Meta endpoints
APP_VERSION=1.0.0
MIN_APP_VERSION=1.0.0
PRIVACY_POLICY_URL=https://dodokid.example.com/privacy
PRIVACY_POLICY_TEXT=

# Set to "development" to expose dev SMS codes in responses (NEVER in production)
NODE_ENV=production

# --- DB tooling only (init-collections.js / seed-content.js) ---
TCB_SECRET_ID=
TCB_SECRET_KEY=

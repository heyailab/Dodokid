# DodoKid 后端环境变量（模板）
# 复制为 .env 后填入真实值；**不要提交真实密钥**。
# 两种部署形态共用本文件，由 DB_DRIVER 切换：
#   cloudbase —— 腾讯云 CloudBase 云函数（云控制台配置这些变量）
#   mongo     —— 自托管（docker compose 读取 .env）

# ---------- 部署形态 ----------
# cloudbase=腾讯 CloudBase；mongo=自托管（你的服务器）
DB_DRIVER=mongo

# ---------- 自托管（DB_DRIVER=mongo）----------
# 直接部署（本文件默认）：本机 MongoDB，已开启鉴权 → 用带凭证的 URI。
# 首次安装时若还没开启鉴权，先用 mongodb://127.0.0.1:27017 建用户，改完配置再回来填。
# Docker 形态：compose 在服务里硬编码了 mongodb://mongo:27017，会覆盖这里的值。
MONGODB_URI=mongodb://dodokid:CHANGE_ME@127.0.0.1:27017/dodokid?authSource=dodokid
MONGODB_DB=dodokid

# ---------- 媒体存储 ----------
# 绘本封面与音频放哪。三选一：
#   local（自托管默认）→ 存服务器本地磁盘，不需要额外开通任何服务
#   cos                → 存腾讯云 COS（后台直传，后端只签发临时凭证）
#   auto               → 配了 COS_* 就用 COS，否则用 local
MEDIA_DRIVER=local
# local 形态的落盘根目录。务必给运行 API 的用户（dodokid）写权限：
#   sudo mkdir -p /var/lib/dodokid/media && sudo chown -R dodokid:dodokid /var/lib/dodokid
MEDIA_ROOT=/var/lib/dodokid/media
# 媒体对外访问路径前缀（与 MEDIA_CDN_BASE_URL 的路径部分保持一致）
MEDIA_PUBLIC_PATH=/media
# 媒体公开地址前缀。自托管填自己的域名，例如 https://dodokid.heymf.cn/media
MEDIA_CDN_BASE_URL=https://dodokid.heymf.cn/media
MEDIA_MAX_SIZE_MB=50
MEDIA_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,audio/mpeg,audio/mp4

# ---------- HTTP 层（server.js）----------
PORT=8080
HTTP_BASE_PATH=/api/v1
# 反向代理层数（Nginx 一层填 1），用于取真实客户端 IP 做限流
TRUST_PROXY=1

# ---------- CloudBase（DB_DRIVER=cloudbase 时需要）----------
TCB_ENV=dodokid-env

# ---------- 签名与令牌 ----------
# JWT 签名密钥，生产环境必填，缺失会启动失败。用长随机串。
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
GATE_TOKEN_TTL_SEC=300

# ---------- 短信验证码 ----------
SMS_CODE_TTL_SEC=300
SMS_CODE_LENGTH=6
SMS_PROVIDER=log

# ---------- 限流（每调用方每分钟）----------
SMS_RATE_LIMIT_PER_MIN=10
LOGIN_RATE_LIMIT_PER_MIN=10
DEFAULT_RATE_LIMIT_PER_MIN=60

# ---------- 元信息 ----------
APP_VERSION=1.0.0
MIN_APP_VERSION=1.0.0
PRIVACY_POLICY_URL=https://dodokid.heymf.cn/privacy
PRIVACY_POLICY_TEXT=

# 生产环境保持 production；设为 development 会在响应里暴露短信验证码
NODE_ENV=production

# ---------- 媒体上传（可选：腾讯云 COS；默认 local 存服务器磁盘）----------
# MEDIA_DRIVER=local 时下面四项留空即可，后台会直传到 MEDIA_ROOT。
# 仅当 MEDIA_DRIVER=cos 时才需要填 COS 凭证。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# ---------- 仅本地/工具脚本需要 ----------
# 在云函数之外运行（本地脚本、db 工具）时需要；云函数内由平台注入
TCB_SECRET_ID=
TCB_SECRET_KEY=

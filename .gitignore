# ---------- 依赖 ----------
node_modules/
.pnp
.pnp.js

# ---------- 构建产物 ----------
dist/
build/
web-build/
coverage/
*.tsbuildinfo

# ---------- Expo ----------
# 本地缓存与 web 检查产物（.expo / .expo-shared / .expo-web-check 等）
.expo/
.expo-*/
# expo prebuild 生成的原生工程：由 CI 或本地 `npx expo prebuild` 重新生成，不入库
/dodokid/android/
/dodokid/ios/

# ---------- Android 签名产物（严禁入库）----------
*.apk
*.aab
*.keystore
*.jks
!*.keystore.example

# ---------- 环境变量与密钥（模板文件保留）----------
.env
.env.*
!.env.example
# 后台生产配置只含非敏感路径（VITE_API_BASE），必须入库，
# 否则 CI/他人克隆后构建出的后台会静默启用内置 Mock。
!dodokid-admin/.env.production

# ---------- 日志 ----------
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 编辑器 / 系统 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ---------- 本地工具数据（记忆日志、团队任务目录）----------
.workbuddy/
